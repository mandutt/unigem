  "summaries": {
    "A": {"adequacy": 3, "critical_unsupported": 0, "critical_omission": 0, "wrong_unit_qualifier": 0, "entity_relation": 0, "fluency": 4, "utility": 4, "evidence": ["로이터, AFP통신 등은 27일(한국시간) 미 연예매체 TMZ를 인용해", "오렌지코스트 칼리지 소속 농구 코치와 부코치, 헬기 조종사 등이 탑승"], "reason": "It keeps the death, the TMZ-based report, the crash location, the passengers and the destination. It leaves out the 9 deaths and the condolences from other athletes, and it drops the teammate's parents from the passenger list. These are minor losses."},
    "B": {"adequacy": 2, "critical_unsupported": 0, "critical_omission": 1, "wrong_unit_qualifier": 0, "entity_relation": 0, "fluency": 3, "utility": 2, "evidence": ["LA 카운티 보안관실은 사고 직후 트위터를 통해 헬기 사고로 총 5명이 사망했다고 전했다.", "그러나 사망자가 늘어 탑승자 9명 전원이 사망했다고 전해졌다."], "reason": "It gives the 5 deaths and the 9 deaths side by side without saying the toll rose. A reader could be misled about the final toll. It also omits the crash location, who else was aboard and the destination. The wording is a little awkward ('9명이 전원이')."},
    "C": {"adequacy": 3, "critical_unsupported": 0, "critical_omission": 0, "wrong_unit_qualifier": 0, "entity_relation": 0, "fluency": 4, "utility": 4, "evidence": ["사망자가 늘어 탑승자 9명 전원이 사망했다고 전해졌다.", "메이저리그 LA 다저스 출신 선수들도 그를 추모하고 있다."], "reason": "It covers the death, the report source, the rising toll to 9 and the tributes from Nike and former Dodgers players. It omits the passengers (including his daughter) and the destination."},
    "D": {"adequacy": 3, "critical_unsupported": 0, "critical_omission": 0, "wrong_unit_qualifier": 0, "entity_relation": 0, "fluency": 4, "utility": 4, "evidence": ["브라이언트의 13세 둘째 딸 지안나와 지안나의 농구팀 동료와 이 동료의 부모", "맘바 스포츠 아카데미로 가려다가 변을 당한 것으로 전해졌다."], "reason": "It accurately gives the passengers, the destination and the crash location. It omits the total of 9 deaths, the source attribution and the other tributes. It also drops the date and the age, which are minor."}
