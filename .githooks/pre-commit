#!/bin/sh
# .githooks/pre-commit — 시크릿·인프라 식별자·재배포 금지 데이터 커밋 차단
# 활성화: sh tools/setup_hooks.sh   (git config core.hooksPath .githooks)
set -u

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

blocked_paths='(^|/)\.env($|\.)|(^|/)\.instabox.*\.env$|\.pem$|\.ppk$|(^|/)id_(rsa|ed25519|ecdsa)|^data/.*\.jsonl$|^assets/gdata_review_sheet.*\.html$|^reports/provenance/W2B/.*(devpred|testpred).*\.json$|^reports/provenance/D0c_vps_.*\.json$|^env/snapshots/[^/]+\.json$'

bad_paths=$(printf '%s\n' "$files" | grep -E -e "$blocked_paths")
rc=$?
if [ "$rc" -eq 2 ]; then
  echo "[pre-commit] 경로 검사 실패 (grep rc=2) — 커밋 중단" >&2
  exit 1
fi
if [ "$rc" -eq 0 ]; then
  echo "" >&2
  echo "[pre-commit] 차단: 로컬 전용 또는 재배포 금지 경로가 스테이징되었습니다." >&2
  printf '%s\n' "$bad_paths" | sed 's/^/    /' >&2
  exit 1
fi

blocked_content='-----BEGIN [A-Z ]*PRIVATE KEY-----|ibk_[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9_-]{24,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|hf_[A-Za-z0-9]{20,}|m_[a-z0-9]{20,}|org_[a-f0-9]{20,}'

added=$(git diff --cached -U0 --no-color -- . | grep -E -e '^\+' | grep -v -E -e '^\+\+\+')
hits=$(printf '%s\n' "$added" | grep -E -e "$blocked_content")
rc=$?
if [ "$rc" -eq 2 ]; then
  echo "[pre-commit] 내용 검사 실패 (grep rc=2) — 커밋 중단" >&2
  exit 1
fi
if [ "$rc" -eq 0 ]; then
  echo "" >&2
  echo "[pre-commit] 차단: 시크릿 또는 인프라 식별자 패턴이 추가되었습니다." >&2
  printf '%s\n' "$hits" | cut -c1-160 | sed 's/^/    /' >&2
  exit 1
fi
